{
  "name": "risk-metric-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:icloud": "node scripts/clean-icloud-conflicts.mjs",
    "clean:icloud": "node scripts/clean-icloud-conflicts.mjs --apply",
    "dev": "npm run prepare:web && vite",
    "build": "npm run prepare:web && vite build",
    "preview": "vite preview",
    "test": "npm run prepare:web && vitest run",
    "test:watch": "npm run prepare:web && vitest",
    "reinstall": "bash scripts/install-nosync.sh",
    "prepare:web": "npm run clean:icloud && node scripts/sync-web-data.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
