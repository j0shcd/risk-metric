# Copy to `.env` and fill in only the keys you use.
# `.env` is git-ignored.

# Optional paid sources
GLASSNODE_API_KEY=
CMC_API_KEY=
COINGECKO_API_KEY=
COINMETRICS_API_KEY=
FRED_API_KEY=
# Legacy alias also supported:
# FRED_API=
WIKIMEDIA_API_TOKEN=
# Recommended by Wikimedia AQS access policy
WIKIMEDIA_API_USER_AGENT=risk-metric/0.1 (you@example.com)

# Optional social sources
YOUTUBE_API_KEY=
# Comma-separated IDs/identifiers: UC... channel IDs, @handles, user:legacy_username, or YouTube channel URLs.
# Example: YOUTUBE_CHANNEL_IDS=@intothecryptoverse,@DigitalAssetNews
YOUTUBE_CHANNEL_IDS=
GOOGLE_TRENDS_API_KEY=
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_TERMS=bitcoin

# Runtime flags
DATA_PROFILE=free_stable
ENABLE_PAID_SOURCES=false
ENABLE_OPTIONAL_SOCIAL_SOURCES=false
REFRESH_API_SOURCES=true
ENABLE_GOOGLE_TRENDS_SOURCE=false

# Quota protection for YouTube free-tier usage
YOUTUBE_MIN_FETCH_INTERVAL_HOURS=24
YOUTUBE_MAX_HANDLE_RESOLUTIONS_PER_RUN=2
